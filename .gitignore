# ---------------------------------------------------------------------------
# Secrets — never commit credentials of any kind.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json

# ---------------------------------------------------------------------------
# Datasets. M5 and Favorita are Kaggle-licensed and ETTm2 is fetched from
# upstream; none of them may be redistributed here. The pipeline regenerates
# everything under data/ from scripts/.
# ---------------------------------------------------------------------------
# Anchored with a leading slash so it matches only the top-level dataset
# directory, never the `src/scalerag/data/` package.
/data/
*.parquet
*.csv
*.csv.gz
*.zip
*.7z
*.tar.gz

# ---------------------------------------------------------------------------
# Model weights and checkpoints — pulled from the public Chronos releases.
# ---------------------------------------------------------------------------
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
.hf_cache/

# ---------------------------------------------------------------------------
# Run outputs. reports/ is regenerable by the scripts in scripts/; the curated
# results that back the paper live in docs/ and are tracked.
# ---------------------------------------------------------------------------
# reports/ is regenerable and excluded, except the small run records the figure
# generator reads -- without these, `make figures` cannot rebuild from a clone.
reports/*
!reports/error-decomposition/
!reports/ettm2-cost/
!reports/regime-threshold/
!reports/phase11a/
reports/error-decomposition/*
!reports/error-decomposition/ettm2-test-error-decomposition.json
reports/ettm2-cost/*
!reports/ettm2-cost/ettm2-val-cost.json
reports/regime-threshold/*
!reports/regime-threshold/m5-val-regime-threshold-1000-50origins.json
reports/phase11a/*
!reports/phase11a/compute_backbone.json
!reports/phase11a/compute_scalerag.json
!reports/phase11a/repro_chronos_bolt_target_ettm2.json
!reports/phase11a/repro_tsrag_official_ettm2.json
!reports/phase11a/scalerag_native_ettm2_test.json
outputs/
artifacts/
logs/
*.lock.json
M5_TEST_CONSUMED.lock

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version.local

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp
